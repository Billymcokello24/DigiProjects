# Local development .env (MySQL) - copy to .env when developing locally
APP_NAME=DigiProjects
APP_ENV=local
APP_KEY=base64:eiD2qZh5HMxpMjAsZOfU9NNooYdOwe4rAcDglNQrFvU=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# DB: use local MySQL for development instead of sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digiprojects
DB_USERNAME=digiprojects_user
DB_PASSWORD=DigiProjectsPassword123!

# Session and Sanctum settings tuned for local dev (vite on localhost:5173)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# Mail and other dev-friendly defaults
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@digiprojects.test"
MAIL_FROM_NAME="${APP_NAME}"

# Keep other production secrets separate
